{
  "name": "voxtype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered speech-to-text and text polishing desktop app",
  "keywords": [
    "speech-to-text",
    "stt",
    "llm",
    "tauri",
    "desktop",
    "voice-input"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hdid67769-sketch/voxtype"
  },
  "homepage": "https://voxtype.net",
  "bugs": {
    "url": "https://github.com/hdid67769-sketch/voxtype/issues"
  },
  "author": "VoxType Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "npm run tauri build && rm -rf /Applications/VoxType.app && cp -R src-tauri/target/release/bundle/macos/VoxType.app /Applications/VoxType.app && echo '✅ 已安装到 /Applications'",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11",
    "@tauri-apps/plugin-clipboard-manager": "^2.2",
    "@tauri-apps/plugin-deep-link": "^2.4",
    "@tauri-apps/plugin-global-shortcut": "^2.3",
    "@tauri-apps/plugin-opener": "^2.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.4",
    "@tauri-apps/plugin-store": "^2.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "better-auth": "^1.6",
    "framer-motion": "^12.42",
    "i18next": "^26.3",
    "lucide-react": "^1.27",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0",
    "zustand": "^5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0",
    "@tailwindcss/vite": "^4.3",
    "@tauri-apps/cli": "^2.11",
    "@testing-library/jest-dom": "^7.0",
    "@testing-library/react": "^16.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.18",
    "eslint-plugin-react-hooks": "^5.2",
    "eslint-plugin-react-refresh": "^0.4",
    "jsdom": "^30.0",
    "prettier": "^3.5",
    "tailwindcss": "^4.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65",
    "vite": "^8.1.5",
    "vitest": "^3.0"
  }
}
